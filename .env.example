# PostgreSQL connection string used by the raw `pg` pool (lib/db.ts).
# Local example: postgresql://postgres:postgres@localhost:5432/rizance
# Hosted (Neon/Supabase) typically requires sslmode=require, e.g.:
#   postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rizance

# Secret used to sign/verify the session JWT (jose, HS256).
# Use a long random string (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
