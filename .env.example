# =============================================================================
# Rizance Profit — environment variables
# Copy to .env.local for local dev. On Vercel, set these in Project → Settings
# → Environment Variables (never commit real values).
# =============================================================================

# --- Required (local + Vercel) ------------------------------------------------

# PostgreSQL connection string (raw `pg` pool in lib/db.ts).
#
# Local:
#   postgresql://postgres:postgres@localhost:5432/rizance
#
# Neon (recommended for Vercel — use the *pooled* connection string):
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Neon dashboard: Project → Connection details → "Pooled connection" → copy URI.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rizance

# Secret for signing session JWTs (jose, HS256). Must be >= 32 chars.
# Generate a new one per environment (do NOT reuse dev secret in production):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- Google OAuth (optional — hide Google login when unset) -------------------

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPx-xxxxx
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# --- Set automatically on Vercel (do not add locally unless debugging) --------

# NODE_ENV=production          # Set by Vercel on deploy
# VERCEL=1                     # Set by Vercel runtime
# VERCEL_ENV=production        # "production" | "preview" | "development"
